# ---------- Database ----------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---------- Store ----------
STORE_NAME=NovaMart
STORE_CURRENCY=USD            # ISO code, e.g. USD, INR, EUR
TAX_PERCENT=0
SUPPORT_EMAIL=support@example.com
ENABLE_COD=true               # Cash on delivery fallback (true/false)

# Public URL of this deployment. Optional - auto-detected from the request if empty.
# Works with http or https, domain names, LAN/private IPs or public IPs, e.g.
#   SITE_URL=http://192.168.1.20:3000
#   SITE_URL=https://shop.example.com
SITE_URL=

# Random string used to sign login cookies (change in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Initial admin account (created automatically on first run)
ADMIN_EMAIL=admin@store.local
ADMIN_PASSWORD=admin123

# ---------- Payment gateways (each is enabled only when its variables are present) ----------
# Razorpay  (https://dashboard.razorpay.com -> API keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# PayPal    (https://developer.paypal.com -> Apps & credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox           # sandbox | live

# Stripe    (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
