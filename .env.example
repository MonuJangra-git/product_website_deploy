# ---------- Database ----------
DATABASE_URL=postgresql://admin:admin@127.0.0.1:5432/app_db
POSTGRES_USER=admin       # changable username for the database user, must be kept private and secure, change in production and use a strong username.
POSTGRES_PASSWORD=admin   # changable password for the database user, must be kept private and secure, change in production and use a strong password.
POSTGRES_DB=app_db        # try to remain same if you are using the default database name, otherwise change it to your desired database name and configure the file drizzle-kit also  . This is the name of the database that will be created and used by the application.
# the above DATABASE_URL uses format postgresql://<username>:<password>@<host>:<port>/<database_name>
# so user can also set the above variables separately and DATABASE_URL will be auto-generated on app start.
# ---------- Store ----------
STORE_NAME=NovaMart   # Store name, e.g. "NovaMart"
STORE_CURRENCY=USD    # ISO code, e.g. USD, INR, EUR
TAX_PERCENT=0
SUPPORT_EMAIL=support@example.com # replace with your support email address orignally in production, this is used for sending order confirmation emails to customers and for receiving support requests from customers.
ENABLE_COD=true               # Cash on delivery fallback (true/false)

# Public URL of this deployment. Optional - auto-detected from the request if empty.
# Works with http or https, domain names, LAN/private IPs or public IPs, e.g.
#   SITE_URL=http://192.168.1.20:3000
#   SITE_URL=https://shop.example.com
SITE_URL=

# Random string used to sign login cookies (change in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Initial admin account (created automatically on first run)
ADMIN_EMAIL=admin@store.local # must be a valid email address and shiould kept private and secure 
ADMIN_PASSWORD=admin123       # also must be kept private and secure, change in production and use a strong password and 2fa if possible. This is used to login to the admin dashboard and manage the store.

# ---------- Payment gateways (each is enabled only when its variables are present) ----------
# below three payment gateways are supported by default, you can add more by creating a plugin for it. See docs for more details.
# these must be kept private and secure, change in production and use a strong password and 2fa if possible. These are used to process payments from customers.
# Razorpay  (https://dashboard.razorpay.com -> API keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# PayPal    (https://developer.paypal.com -> Apps & credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox           # sandbox | live

# Stripe    (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
